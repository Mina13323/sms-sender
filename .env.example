# --- Database (PostgreSQL — Supabase in production) ---
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the pooler connection string on Vercel, e.g.:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Auth ---
# Secret for signing session tokens. Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Credential encryption at rest ---
# 32-byte base64 key for AES-256-GCM encryption of provider credentials.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Public base URL (optional, enables delivery tracking) ---
# When set, Twilio is asked to POST delivery-status callbacks to
# <APP_PUBLIC_BASE_URL>/api/sms/status. Must be publicly reachable by Twilio
# (use a tunnel such as ngrok/cloudflare in local dev). Leave empty to skip
# status callbacks — sending still works, only delivery tracking is off.
# APP_PUBLIC_BASE_URL=https://sms.example.com

# --- Initial Super Admin (used by scripts/seed.mjs only) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional: also seed example routes on first seed ---
# SEED_EXAMPLE_ROUTES=1

# --- DEV ONLY: allow Generic HTTP providers to target loopback (stub servers).
# NEVER set this in production. ---
# SMS_HTTP_ALLOW_LOCAL=1
